@model ServiceHub.Web.Models.ViewModels.ProviderServiceFormViewModel
@{
    ViewData["Title"] = "Add a Service";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a asp-action="Services" class="text-decoration-none">&larr; My services</a>
        <div class="card shadow-sm mt-3">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Add a service</h1>
                <form asp-action="CreateService" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <partial name="_ServiceFormFields" model="Model" />
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Add service</button>
                        <a asp-action="Services" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
