@model ServiceHub.Web.Models.ViewModels.ProviderProfileViewModel
@{
    ViewData["Title"] = "Provider Profile";
    ViewData["HeaderTitle"] = "Provider Profile";
    ViewData["HeaderSubtitle"] = "View and manage your service provider account details.";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <a asp-action="Dashboard" class="text-decoration-none text-muted small">&larr; Back to Dashboard</a>

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="user-avatar-circle" style="width: 56px; height: 56px; font-size: 1.4rem;">
                        @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "P")
                    </div>
                    <div>
                        <h2 class="h4 mb-1 profile-display-name">@Model.FullName</h2>
                        <span class="badge bg-primary">Service Provider</span>
                        <span class="text-muted small ms-2">Member since @Model.CreatedAtUtc.ToString("MMMM yyyy")</span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded text-center">
                            <span class="text-muted small d-block">Services Catalog</span>
                            <span class="h4 fw-bold mb-0">@Model.TotalServicesOffered</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded text-center">
                            <span class="text-muted small d-block">Active Offerings</span>
                            <span class="h4 fw-bold mb-0 text-success">@Model.ActiveServicesCount</span>
                        </div>
                    </div>
                </div>

                <h3 class="h5 mb-3">Edit Profile Details</h3>
                <form id="providerProfileForm" asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-validation-summary alert alert-danger d-none" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-medium"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-medium"></label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                        <div class="form-text">Your email address is managed via your security credentials.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-medium"></label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/provider-crud.js" asp-append-version="true"></script>
}
