@model ServiceHub.Web.Models.ViewModels.ProviderServiceFormViewModel

<div class="mb-3">
    <label asp-for="ServiceName" class="form-label"></label>
    <input asp-for="ServiceName" class="form-control" maxlength="120" autocomplete="off" />
    <span asp-validation-for="ServiceName" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Price" class="form-control" type="number" min="0" max="99999999.99" step="0.01" />
        </div>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EstimatedDurationMinutes" class="form-label"></label>
        <input asp-for="EstimatedDurationMinutes" class="form-control" type="number" min="1" max="1440" />
        <span asp-validation-for="EstimatedDurationMinutes" class="text-danger"></span>
    </div>
</div>
<div class="form-check">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label"></label>
</div>
