@model ServiceHub.Web.Models.ViewModels.ServiceProviderDashboardViewModel
@{
    ViewData["Title"] = "Service Provider Dashboard";
    ViewData["HeaderTitle"] = "Provider Dashboard";
    ViewData["HeaderSubtitle"] = "Overview of your service listings, profile, and performance.";
}

@Html.AntiForgeryToken()

<div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-medium">Total Services</span>
                    <span class="badge bg-primary-subtle text-primary p-2 rounded-circle">
                        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1zm3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4h-3.5z"/>
                        </svg>
                    </span>
                </div>
                <h3 class="display-6 fw-bold mb-0">@Model.Services.Count</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-medium">Active Services</span>
                    <span class="badge bg-success-subtle text-success p-2 rounded-circle">
                        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                        </svg>
                    </span>
                </div>
                <h3 class="display-6 fw-bold mb-0">@Model.Services.Count(s => s.IsActive)</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 h-100 bg-primary text-white">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <span class="text-white-50 small fw-medium">Quick Action</span>
                    <h4 class="h5 fw-bold mt-1 text-white">Expand Your Catalog</h4>
                </div>
                <div class="mt-3">
                    <button type="button" class="btn btn-light btn-sm text-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                        + Add a service
                    </button>
                    <a asp-action="Profile" class="btn btn-outline-light btn-sm ms-1">My Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <p class="text-uppercase text-primary fw-semibold small mb-1">Service provider workspace</p>
                <h2 class="h3 mb-1">Welcome back, <span class="profile-display-name">@Model.FullName</span></h2>
                <p class="text-muted mb-0 small">Here is a quick view of your currently listed services.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Services" class="btn btn-outline-primary btn-sm">View all services</a>
                <a asp-action="CreateService" class="btn btn-primary btn-sm">Add a service</a>
            </div>
        </div>

        @if (Model.Services.Count == 0)
        {
            <div class="alert alert-light border text-center py-4 mb-0" role="status">
                <p class="mb-2 text-muted">You have not added any services yet.</p>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addServiceModal">
                    Add your first service
                </button>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var service in Model.Services.Take(3))
                {
                    <div class="col-12 col-lg-4">
                        <article class="card h-100 service-item-card border shadow-xs">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 card-title mb-0">@service.ServiceName</h3>
                                    <span class="badge @(service.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(service.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                                <p class="text-muted small flex-grow-1">@(service.Description ?? "No description provided.")</p>
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                    <div>
                                        <strong class="fs-5">$@service.Price.ToString("0.00")</strong>
                                        <span class="text-muted small">&middot; @service.EstimatedDurationMinutes min</span>
                                    </div>
                                    <a asp-action="ServiceDetails" asp-route-id="@service.Id" class="btn btn-outline-primary btn-sm">Details</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- Add Service Modal for Dashboard -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="dashboardAddServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title" id="dashboardAddServiceModalLabel">Add New Service</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addServiceForm">
                @Html.AntiForgeryToken()
                <div class="modal-body pt-3">
                    <div class="form-validation-summary alert alert-danger d-none" role="alert"></div>
                    <partial name="_ServiceFormFields" model="new ServiceHub.Web.Models.ViewModels.ProviderServiceFormViewModel()" />
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Add Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/provider-crud.js" asp-append-version="true"></script>
}
