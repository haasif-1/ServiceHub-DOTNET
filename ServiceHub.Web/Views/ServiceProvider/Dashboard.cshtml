@model ServiceHub.Web.Models.ViewModels.ServiceProviderDashboardViewModel
@{
    ViewData["Title"] = "Service Provider Dashboard";
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<section class="card dashboard-card">
    <div class="card-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <p class="text-uppercase text-primary fw-semibold mb-2">Service provider dashboard</p>
                <h1 class="h2 mb-2">Welcome, @Model.FullName</h1>
                <p class="text-muted mb-0">Manage the services you offer.</p>
            </div>
            <a asp-action="CreateService" class="btn btn-primary">Add a service</a>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">My services</h2>
            <a asp-action="Services" class="btn btn-outline-primary btn-sm">View all</a>
        </div>

        @if (Model.Services.Count == 0)
        {
            <div class="alert alert-light border mb-0" role="status">
                You have not added any services yet.
                <a asp-action="CreateService">Add your first service</a>.
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var service in Model.Services.Take(3))
                {
                    <div class="col-12 col-lg-4">
                        <article class="card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <h3 class="h5 card-title">@service.ServiceName</h3>
                                    <span class="badge @(service.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(service.IsActive ? "Active" : "Inactive")
                                    </span>
                                </div>
                                <p class="text-muted small">@(service.Description ?? "No description provided.")</p>
                                <p class="mb-3">
                                    <strong>@service.Price.ToString("0.00")</strong>
                                    <span class="text-muted">&middot; @service.EstimatedDurationMinutes min</span>
                                </p>
                                <a asp-action="ServiceDetails" asp-route-id="@service.Id" class="btn btn-outline-primary btn-sm">Details</a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        </div>
    </div>
</section>
