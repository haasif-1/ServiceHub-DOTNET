@model ServiceHub.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="card dashboard-card">
    <div class="card-body">
        <p class="text-uppercase text-primary fw-semibold mb-2">Admin dashboard</p>
        <h1 class="h2 mb-2">Welcome, @Model.FullName</h1>
        <p class="text-muted mb-4">Role: <strong>@Model.Role</strong></p>
        <div class="alert alert-light border mb-0" role="status">
            Dashboard functionality will be implemented in a later phase.
        </div>
    </div>
</section>
