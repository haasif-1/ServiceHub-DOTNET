@{
    ViewData["Title"] = "Check your email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm auth-card">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Check your email</h1>
                <p>If that email is registered, a password reset link has been sent. In local development the link is written to the application log.</p>
                <a class="btn btn-primary" asp-action="Login">Back to login</a>
            </div>
        </div>
    </div>
</div>
