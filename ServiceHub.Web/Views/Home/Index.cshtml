@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">ServiceHub</h1>
        <p class="col-md-8 fs-5">Find trusted local services or offer your skills. Create an account to get started.</p>
        <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Create account</a>
        <a class="btn btn-outline-secondary btn-lg ms-2" asp-controller="Account" asp-action="Login">Log in</a>
    </div>
</div>
